# DuoSigna Backend Configuration
# Copy this file to .env and fill in your values

# PostgreSQL Database Connection String (e.g. from Neon.tech)
DATABASE_URL="postgresql://username:password@ep-your-database.neon.tech/neondb?sslmode=require"

# Groq Cloud API Key for AI Tutor Dialogue (get one for free at https://console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Secret Key for JWT token signing
JWT_SECRET="generate_a_secure_random_string_here"
